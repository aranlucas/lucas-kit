{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2023",
    "types": ["node"]
  },
  "include": [
    "*.mjs",
    "*.ts",
    "tools/**/*.mjs",
    "tests/**/*.mjs",
    "plugins/pstack/**/*.mjs",
    "plugins/pstack/pi/**/*.ts"
  ]
}
