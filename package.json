{
  "name": "@aranlucas/kit-skills",
  "version": "1.0.16",
  "private": true,
  "type": "module",
  "description": "Lucas Kit agent workflows for T3 Code, with shared skills and optional plugin integrations.",
  "keywords": [
    "pi-package",
    "t3-code",
    "pstack",
    "poteto-mode",
    "workflow",
    "principles",
    "agent-style",
    "subagents",
    "unslop",
    "claude-code",
    "skills",
    "tdd",
    "code-review",
    "parallel-agents",
    "codex",
    "opencode",
    "gemini-cli",
    "prime-agent"
  ],
  "homepage": "https://github.com/aranlucas/lucas-kit",
  "license": "MIT",
  "author": {
    "name": "Lucas",
    "url": "https://github.com/aranlucas"
  },
  "repository": "https://github.com/aranlucas/lucas-kit",
  "scripts": {
    "pack:skills": "node tools/pack-skills.mjs",
    "generate": "node tools/generate.mjs",
    "generate:check": "node tools/generate.mjs --check",
    "sync": "node tools/sync.mjs",
    "test": "vitest run",
    "test:pnpm": "vitest run test/pnpm-skills.test.mjs",
    "typecheck:pi": "node tools/typecheck-pi.mjs",
    "lint": "oxlint && pnpm lint:test",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "lint:test": "oxlint --config node_modules/@aranlucas/oxforge/configs/vitest.json test --deny-warnings",
    "prepare": "husky",
    "build": "pnpm pack:skills",
    "pretest": "pnpm lint:test"
  },
  "devDependencies": {
    "@aranlucas/oxforge": "0.2.2",
    "@types/node": "26.6.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "typebox": "1.4.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "packageManager": "pnpm@12.14.0",
  "pi": {
    "skills": [
      "./plugins/pstack/skills"
    ],
    "extensions": [
      "./plugins/pstack/pi/index.ts"
    ]
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "oxlint --fix --no-error-on-unmatched-pattern",
      "oxfmt --config oxfmt.config.ts --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc,json5,css,scss,md,mdx,yml,yaml,html,toml,vue,svelte,astro,graphql}": [
      "oxfmt --config oxfmt.config.ts --no-error-on-unmatched-pattern"
    ]
  }
}
