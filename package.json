{
  "name": "@aranlucas/kit-skills",
  "version": "1.0.16",
  "private": true,
  "description": "Lucas Kit agent workflows for T3 Code, with shared skills and optional plugin integrations.",
  "keywords": [
    "pi-package",
    "t3-code",
    "pstack",
    "poteto-mode",
    "workflow",
    "principles",
    "agent-style",
    "subagents",
    "unslop",
    "claude-code",
    "skills",
    "tdd",
    "code-review",
    "parallel-agents",
    "codex",
    "opencode",
    "gemini-cli",
    "prime-agent"
  ],
  "homepage": "https://github.com/aranlucas/lucas-kit",
  "license": "MIT",
  "author": {
    "name": "Lucas",
    "url": "https://github.com/aranlucas"
  },
  "repository": "https://github.com/aranlucas/lucas-kit",
  "scripts": {
    "pack:skills": "node tools/pack-skills.mjs",
    "generate": "node tools/generate.mjs",
    "generate:check": "node tools/generate.mjs --check",
    "sync": "node tools/sync.mjs",
    "test": "pnpm lint:test && vitest run",
    "test:pnpm": "vitest run test/pnpm-skills.test.mjs",
    "typecheck:pi": "node tools/typecheck-pi.mjs",
    "lint": "oxlint && pnpm lint:test",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "lint:test": "oxlint --config node_modules/@aranlucas/oxforge/configs/vitest.json test --deny-warnings"
  },
  "devDependencies": {
    "@aranlucas/oxforge": "0.2.2",
    "@types/node": "24.19.2",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "typebox": "1.3.34",
    "vite": "8.3.3",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "packageManager": "pnpm@12.11.0",
  "pi": {
    "skills": [
      "./plugins/pstack/skills"
    ],
    "extensions": [
      "./plugins/pstack/pi/index.ts"
    ]
  }
}
